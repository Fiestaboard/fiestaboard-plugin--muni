{
  "id": "muni",
  "name": "SF Muni",
  "version": "1.2.0",
  "description": "Display San Francisco Muni transit arrival times with multi-line support",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--muni",
  "documentation": "README.md",
  "icon": "train",
  "category": "transit",
  "min_refresh_seconds": 30,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Muni",
        "default": false
      },
      "api_key": {
        "type": "string",
        "title": "511.org API Key",
        "description": "Get free key at 511.org/developers",
        "ui:widget": "password"
      },
      "route": {
        "type": "string",
        "title": "Route Filter",
        "description": "Narrow the stop list to one Muni route while you pick. Leave empty to search every stop.",
        "ui:widget": "remote-options",
        "ui:options": {
          "options_id": "routes",
          "searchable": true,
          "cache_seconds": 3600,
          "placeholder": "All routes"
        }
      },
      "stop_codes": {
        "type": "array",
        "title": "Stops",
        "description": "Muni stops to monitor (max 4)",
        "maxItems": 4,
        "items": {
          "type": "string"
        },
        "ui:widget": "remote-options",
        "ui:options": {
          "options_id": "stops",
          "depends_on": [
            "route"
          ],
          "multiple": true,
          "reorderable": true,
          "searchable": true,
          "server_search": true,
          "allow_custom": true,
          "cache_seconds": 900,
          "placeholder": "Search stops by name"
        }
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "default": 60,
        "minimum": 30
      }
    },
    "required": [
      "api_key",
      "stop_codes"
    ]
  },
  "env_vars": [
    {
      "name": "MUNI_API_KEY",
      "required": true,
      "description": "511.org API key"
    },
    {
      "name": "MUNI_STOP_CODE",
      "required": false,
      "description": "Single stop code (legacy)"
    },
    {
      "name": "MUNI_STOP_CODES",
      "required": false,
      "description": "Comma-separated stop codes"
    },
    {
      "name": "MUNI_LINE_NAME",
      "required": false,
      "description": "Filter to specific line (e.g., N)"
    }
  ],
  "variables": {
    "groups": {
      "stop_info": {
        "label": "First Stop"
      },
      "display": {
        "label": "Display"
      }
    },
    "simple": {
      "stop_name": {
        "description": "Name of the first monitored stop",
        "type": "string",
        "max_length": 15,
        "group": "stop_info",
        "example": "Church & Duboce"
      },
      "stop_code": {
        "description": "Stop code of the first stop",
        "type": "string",
        "max_length": 6,
        "group": "stop_info",
        "example": "15726"
      },
      "line": {
        "description": "Line name at the first stop",
        "type": "string",
        "max_length": 12,
        "group": "stop_info",
        "example": "N-Judah"
      },
      "formatted": {
        "description": "Pre-formatted arrival display",
        "type": "string",
        "max_length": 22,
        "group": "display",
        "example": "N 3min  KT 8min"
      },
      "is_delayed": {
        "description": "Whether service is delayed",
        "type": "boolean",
        "max_length": 3,
        "group": "stop_info",
        "example": "No"
      },
      "stop_count": {
        "description": "Number of monitored stops",
        "type": "number",
        "max_length": 1,
        "group": "display",
        "example": "2"
      }
    },
    "arrays": {
      "stops": {
        "label_field": "stop_name",
        "item_fields": [
          "stop_code",
          "stop_name",
          "formatted",
          "is_delayed"
        ],
        "sub_arrays": {
          "lines": {
            "key_type": "dynamic",
            "key_field": "line_code",
            "item_fields": [
              "line",
              "line_code",
              "formatted",
              "next_arrival",
              "is_delayed"
            ]
          }
        }
      }
    }
  },
  "max_lengths": {
    "stops.*.stop_name": 15,
    "stops.*.formatted": 22,
    "stops.*.lines.*.line": 12,
    "stops.*.lines.*.formatted": 22,
    "stops.*.lines.*.next_arrival": 2
  },
  "color_rules_schema": {
    "is_delayed": {
      "type": "match",
      "description": "Color when delayed",
      "default_rules": [
        {
          "condition": "==",
          "value": true,
          "color": "red"
        }
      ]
    }
  },
  "fiestaboard_version": ">=8.24.2",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "SF Muni displayed on a Vestaboard",
      "caption": "Display San Francisco Muni transit arrival times with multi-line support",
      "primary": true
    }
  ],
  "teaser": "N JUDAH 3 MIN",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}",
        "N JUDAH  CHURCH  3 MIN",
        "N JUDAH  CHURCH 12 MIN",
        "7 HAIGHT DUBOCE  8 MIN",
        "38 GEARY POWELL  5 MIN",
        "38 GEARY POWELL 14 MIN"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{63}{63} MUNI",
        "N JUDAH  3 MIN",
        "KT INGLE 8 MIN"
      ]
    }
  ],
  "demo": {
    "flagship": {
      "name": "Muni Arrivals Demo",
      "template": [
        "Muni Arrivals",
        "{{muni.stop_name}}",
        "{{muni.formatted}}",
        "",
        "",
        "Stops {{muni.stop_count}}"
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "Muni (Note)",
      "template": [
        "{{muni.stop_name}}",
        "{{muni.formatted}}",
        ""
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
